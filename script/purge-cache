#!/usr/bin/env bash
set -euo pipefail
set +x
umask 077
fail() { printf 'Cache purge error: %s\n' "$*" >&2; exit 1; }
[[ ${DEPLOY_DRY_RUN:-1} == 0 ]] || { printf 'Skipping cache purge for a dry run.\n'; exit 0; }
[[ -n ${CF_API_TOKEN:-} ]] || fail "The CF_API_TOKEN secret is missing."
[[ ${CF_ZONE_ID:-} =~ ^[a-fA-F0-9]{32}$ ]] || fail "The CF_ZONE_ID secret is missing or invalid."
for tool in curl jq; do
  command -v "$tool" >/dev/null || fail "The runner needs $tool."
done
state_dir=$(mktemp -d /tmp/site-cache.XXXXXXXX)
trap 'rm -rf -- "$state_dir"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
http_status=$(curl --proto '=https' --tlsv1.2 --silent --show-error \
  --connect-timeout 10 --max-time 60 --request POST \
  "https://api.cloudflare.com/client/v4/zones/${CF_ZONE_ID}/purge_cache" \
  --header "Authorization: Bearer ${CF_API_TOKEN}" \
  --header "Content-Type: application/json" \
  --data '{"purge_everything":true}' \
  --output "$state_dir/response.json" --write-out '%{http_code}' \
  2> "$state_dir/request.log") || fail "Cloudflare request failed."
[[ $http_status =~ ^2[0-9][0-9]$ ]] || fail "Cloudflare returned an unsuccessful HTTP status."
jq -e '.success == true' "$state_dir/response.json" >/dev/null 2>&1 || fail "Cloudflare did not confirm cache purge success."
printf 'Cloudflare confirmed cache purge success.\n'
